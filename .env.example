MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=reelrouter
MYSQL_USER=reelrouter
MYSQL_PASSWORD=replace_with_your_local_password
MYSQL_ROOT_PASSWORD=replace_with_your_local_root_password

DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_MODEL=your_deepseek_model_name

# Ark Story Writer（真实小说生成）。不要将真实密钥提交到 Git。
ARK_API_KEY=replace_with_your_ark_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_STORY_MODEL=your_ark_model_id_or_endpoint_id
ARK_STORY_MAX_TOKENS=8192
# 结构化 JSON 创作默认关闭思考，避免 reasoning 耗尽输出额度。
ARK_STORY_THINKING=disabled
ARK_STORY_TEMPERATURE=0.2

# Ark Seedance Video（真实异步视频生成）。
# DOUBAO_VIDEO_MODEL 填写方舟控制台中的 Seedance 模型 ID 或 Endpoint ID。
# 以下美元/秒不是供应商报价，只是视频提交前预算护栏的保守预估值；
# 首个单镜头任务完成后，应按控制台实际账单校准。
DOUBAO_VIDEO_MODEL=your_seedance_model_id_or_endpoint_id
SEEDANCE_ESTIMATED_COST_PER_SECOND_USD=0.15
ARK_VIDEO_TIMEOUT_SECONDS=60

RUNWAY_API_KEY=replace_with_your_key
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_API_VERSION=2024-11-06

# 视频 API 默认使用 Mock，避免本地启动即发生真实计费。
# 真正运行 Runway 前明确改为 runway，并确认 RUNWAY_API_KEY 正确。
VIDEO_PROVIDER=mock

# Vue 开发服务器的可信来源；部署时替换成真实前端域名。
WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
